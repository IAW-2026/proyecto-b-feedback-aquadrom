// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Nota: La URL ahora se gestiona desde prisma.config.ts usando env("DATABASE_URL")
}

model Resena {
  id_resena Int      @id @default(autoincrement())
  id_pedido     String   // Referencia al pedido original en SellerApp 
  id_usuario    String   // El ID del Comprador (sub de Clerk) 
  id_vendedor   String   // El ID del Vendedor calificado 
  estrellas     Int      // Calificación del 1 al 5 
  comentario    String?  @db.Text
  foto          String?  // URL de la imagen (te conviene agregarlo por el Entregable 1.4) 
  fecha         DateTime @default(now())
}

model Valoracion {
  id_valoracion    Int      @id @default(autoincrement())
  id_pedido        String
  id_usuario       String
  id_vendedor      String
  comentario       String
  estrellas        Int
  fecha            DateTime @default(now())
}

model AdminFeedback {
  id_admin   Int    @id @default(autoincrement())
  id_usuario String @unique // El 'sub' de Clerk del moderador
  nombre     String
}