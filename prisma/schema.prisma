// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Resena {
  id_resena     Int      @id @default(autoincrement())
  id_pedido     String   @unique // Es unique para la relación 1 a 1 con Pedido
  pedido        Pedido   @relation(fields: [id_pedido], references: [id_pedido])
  id_usuario    String   // El ID del Comprador (sub de Clerk) 
  id_vendedor   String   // El ID del Vendedor calificado 
  estrellas     Int      // Calificación del 1 al 5 
  comentario    String?  @db.Text
  foto          String?  // URL de la imagen
  fecha         DateTime @default(now())
}

model Valoracion {
  id_valoracion    Int      @id @default(autoincrement())
  id_usuario       String
  comentario       String
  estrellas        Int
  fecha            DateTime @default(now())
}

model AdminFeedback {
  id_admin   Int    @id @default(autoincrement())
  id_usuario String @unique // El 'sub' de Clerk del moderador
  nombre     String
}

model Pedido {
  id_pedido               String   @id // El ID que envían desde la API externa
  id_vendedor             String   // ID del vendedor
  id_comprador            String   // ID del usuario (de Clerk)
  snapshot_producto_nombre String
  snapshot_producto_precio Float
  estado                  String
  fecha                   DateTime @default(now())
  monto                   Float
  resena                  Resena?  // Relación opcional con la tabla de Reseñas, si tiene reseña o no asociada
}